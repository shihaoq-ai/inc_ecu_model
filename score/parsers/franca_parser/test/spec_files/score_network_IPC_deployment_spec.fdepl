	}
	for provided_ports {
		ScoreProperty252:						Integer						;
		ScoreProperty249:							Integer						(default: 42);
		ScoreProperty257:							Integer						(default: 42);
        ScoreProperty279:       String                      (optional);
        ScoreProperty278: String                      (optional);
        ScoreProperty489:     Integer                     (default: 42);
        ScoreProperty262:      Integer                   (default: 42);
        ScoreProperty107:          {ScoreValue001, ScoreValue009, ScoreValue010, ScoreValue030, ScoreValue183}              (default: ScoreValue183);
	}
	for required_ports {
		ScoreProperty316:				Integer						(optional);
		ScoreProperty281:       String                      (optional);
